.hero {
  padding: 48rpx 40rpx 44rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #1d2a35, #2c3e50);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(29, 42, 53, 0.25);
}

.hero-badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  margin-bottom: 20rpx;
  background: rgba(77, 185, 0, 0.18);
  border: 2rpx solid rgba(126, 211, 33, 0.35);
  border-radius: 999rpx;
  color: #9be15d;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.illu-sm {
  transform: scale(0.72);
  transform-origin: top right;
  margin: 10rpx 0 0 16rpx;
}

/* ---------- 迷你 7 天预报 ---------- */
.hw-forecast {
  display: flex;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.14);
}

.hw-fc-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hw-fc-week {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.65);
}

.hw-fc-dot {
  width: 18rpx;
  height: 18rpx;
  margin: 12rpx 0 10rpx;
  border-radius: 50%;
  box-shadow: inset 0 -3rpx 6rpx rgba(0, 0, 0, 0.12);
}

.hw-fc-temp {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.hero-title {
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 12rpx;
  color: #9aa5b1;
  font-size: 24rpx;
}

/* ---------- 顶部天气摘要 ---------- */
.hero-weather {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 18rpx 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 18rpx;
}

.hero-weather-hover {
  background: rgba(255, 255, 255, 0.16);
}

.hw-dot {
  width: 34rpx;
  height: 34rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  box-shadow: 0 0 14rpx rgba(255, 215, 110, 0.45), inset 0 -5rpx 10rpx rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}

.hw-city {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.hw-district {
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.75);
}

.hw-divider {
  width: 2rpx;
  height: 24rpx;
  margin: 0 20rpx;
  background: rgba(255, 255, 255, 0.3);
}

.hw-desc {
  flex: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.hw-temp {
  font-size: 32rpx;
  font-weight: 700;
  color: #9be15d;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.hw-arrow {
  margin-left: 14rpx;
  font-size: 32rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.6);
}

.demo-card {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 28rpx;
  background-color: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 41, 51, 0.05);
  transition: transform 0.15s ease;
}

.demo-card-hover {
  transform: scale(0.98);
  background-color: #fafbfc;
}

.demo-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 24rpx;
  background: linear-gradient(135deg, #4db900, #7ed321);
  border-radius: 18rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.demo-body {
  flex: 1;
  min-width: 0;
}

.demo-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2933;
}

.demo-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8f99;
  line-height: 34rpx;
}

.demo-arrow {
  margin-left: 16rpx;
  color: #c3c9d3;
  font-size: 40rpx;
  font-weight: 300;
}