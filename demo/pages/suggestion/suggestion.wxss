.search-box {
  position: relative;
  height: 84rpx;
  margin-bottom: 24rpx;
}

.search-icon {
  position: absolute;
  left: 28rpx;
  top: 27rpx;
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid #b9bec7;
  border-radius: 50%;
  z-index: 1;
  pointer-events: none;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 4rpx;
  background-color: #b9bec7;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding: 0 28rpx 0 76rpx;
  background-color: #fff;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 41, 51, 0.05);
  font-size: 28rpx;
}

.search-placeholder {
  color: #b9bec7;
}

.sug-card {
  padding: 8rpx 28rpx;
}

.sug-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f4f5f8;
}

.sug-item:last-child {
  border-bottom: none;
}

.sug-hover {
  opacity: 0.7;
}

.sug-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  background: #eef7e4;
  border-radius: 12rpx;
  color: #4db900;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.sug-body {
  flex: 1;
  min-width: 0;
}

.sug-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2933;
}

.sug-address {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a8f99;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sug-city {
  padding: 6rpx 16rpx;
  margin-left: 16rpx;
  background: #f4f5f8;
  border-radius: 999rpx;
  color: #6b7280;
  font-size: 22rpx;
  flex-shrink: 0;
}