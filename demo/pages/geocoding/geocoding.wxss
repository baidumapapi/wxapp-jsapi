.geocoding-input {
  margin-left: 0;
}

/* ---------- 解析结果（rs-addr 系列见 app.wxss） ---------- */
.rs-coords {
  display: flex;
  margin-bottom: 24rpx;
}

.rs-item {
  flex: 1;
}

.rs-item + .rs-item {
  margin-left: 16rpx;
  padding-left: 32rpx;
  border-left: 2rpx solid #f0f1f5;
}

.rs-label {
  font-size: 22rpx;
  color: #8a8f99;
}

.rs-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #4db900;
  letter-spacing: 1rpx;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}