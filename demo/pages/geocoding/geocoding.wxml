<view class="page">
  <view class="card">
    <input
      class="field-input geocoding-input"
      placeholder="输入地址，如：北京市海淀区上地十街10号"
      placeholder-class="field-placeholder"
      value="{{address}}"
      confirm-type="search"
      bindinput="onAddressInput"
      bindconfirm="resolveAddress"
    />
    <button class="btn btn-primary btn-block" bindtap="resolveAddress">解析地址</button>
  </view>

  <view class="map-wrap">
    <map
      class="map"
      longitude="{{longitude}}"
      latitude="{{latitude}}"
      scale="14"
      show-location
      markers="{{markers}}"
      bindmarkertap="onMarkerTap"
    />

    <view class="map-loading" wx:if="{{loading}}">
      <view class="spinner" />
      <text>解析中…</text>
    </view>
  </view>

  <view class="card" wx:if="{{result}}">
    <view class="card-title">解析结果</view>

    <view class="rs-addr">
      <text class="rs-addr-label">地址</text>
      <text class="rs-addr-value">{{result.address}}</text>
    </view>

    <view class="rs-coords">
      <view class="rs-item">
        <view class="rs-label">经度</view>
        <view class="rs-value">{{result.lng}}</view>
      </view>
      <view class="rs-item">
        <view class="rs-label">纬度</view>
        <view class="rs-value">{{result.lat}}</view>
      </view>
    </view>

    <button class="btn btn-outline btn-block" bindtap="copyCoords">复制坐标</button>
  </view>

  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>