<view class="page">
  <!-- ============ 搜索框 ============ -->
  <view class="search-box">
    <view class="search-icon" />
    <input
      class="search-input"
      placeholder="输入关键词，如：烤鸭店"
      placeholder-class="search-placeholder"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="confirmSearch"
    />
    <view class="search-btn" bindtap="confirmSearch">检索</view>
  </view>

  <!-- ============ 场景快选 ============ -->
  <view class="scene-bar">
    <view class="scene-chip {{activeScene === item ? 'scene-active' : ''}}"
          wx:for="{{scenes}}" wx:key="*this"
          data-scene="{{item}}" bindtap="onSceneTap">{{item}}</view>
  </view>

  <!-- ============ 地图 ============ -->
  <view class="map-wrap">
    <map
      class="map"
      longitude="{{longitude}}"
      latitude="{{latitude}}"
      scale="14"
      show-location
      markers="{{markers}}"
      bindmarkertap="onMarkerTap"
    />

    <view class="map-loading" wx:if="{{loading}}">
      <view class="spinner" />
      <text>正在检索「{{activeScene || keyword}}」附近…</text>
    </view>
  </view>

  <!-- ============ 选中详情 ============ -->
  <view class="card detail-card" wx:if="{{detail}}">
    <view class="dc-head">
      <view class="dc-title">{{detail.title}}</view>
      <view class="dc-dist">{{detail.distText}} 距你</view>
    </view>
    <view class="info-row" wx:for="{{detail.rows}}" wx:key="label">
      <text class="info-label">{{item.label}}</text>
      <text class="info-value">{{item.value}}</text>
    </view>
  </view>

  <!-- ============ 结果列表 ============ -->
  <view class="card poi-card" wx:if="{{pois.length}}">
    <view class="poi-item {{selectedId === index ? 'poi-active' : ''}}"
          wx:for="{{pois}}" wx:key="id"
          data-id="{{item.id}}" hover-class="poi-hover" bindtap="onPoiTap">
      <view class="poi-badge">{{index + 1}}</view>
      <view class="poi-body">
        <view class="poi-title">{{item.title}}</view>
        <view class="poi-addr">{{item.address || '—'}}{{item.telephone ? ' · ' + item.telephone : ''}}</view>
      </view>
      <text class="poi-dist">{{item.distText}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !pois.length && !error}}">未找到相关地点，换个关键词试试</view>

  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>