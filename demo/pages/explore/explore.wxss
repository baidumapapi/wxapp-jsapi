/* ================= 地图与浮层 ================= */
.map-main {
  height: 560rpx;
  margin: 24rpx 24rpx 0;
  position: relative;
}

.map-cap {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 12rpx 22rpx;
  background: rgba(31, 41, 51, 0.82);
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  color: #fff;
}

.cap-dot {
  width: 20rpx;
  height: 20rpx;
  margin-right: 10rpx;
  border-radius: 50%;
}

.cap-text {
  font-size: 22rpx;
}

.cap-arrow {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ================= 当前位置条 ================= */
.loc-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 16rpx 22rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 51, 0.05);
}

.loc-pin {
  color: #4db900;
  font-size: 20rpx;
  margin-right: 12rpx;
}

.loc-text {
  flex: 1;
  font-size: 23rpx;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-refresh {
  margin-left: 16rpx;
  padding: 4rpx 18rpx;
  background: #eef7e4;
  border-radius: 999rpx;
  color: #4d7c0f;
  font-size: 21rpx;
  flex-shrink: 0;
}

/* ================= 天气卡 ================= */
.weather-panel {
  margin-top: 20rpx;
  color: #fff;
  padding: 24rpx 28rpx 20rpx;
}

.wp-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.wp-city {
  font-size: 30rpx;
  font-weight: 600;
}

.wp-district {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.85);
}

.wp-now {
  font-size: 26rpx;
  font-weight: 600;
}

.wp-feels {
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.8);
}

.wp-forecast {
  display: flex;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.16);
}

.wp-fc {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wp-fc-week {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

.wp-fc-dot {
  width: 16rpx;
  height: 16rpx;
  margin: 10rpx 0 8rpx;
  border-radius: 50%;
}

.wp-fc-temp {
  font-size: 22rpx;
  font-weight: 600;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

/* ================= 搜索框 ================= */
.search-box {
  position: relative;
  height: 84rpx;
  margin: 20rpx 24rpx 0;
}

.search-icon {
  position: absolute;
  left: 30rpx;
  top: 29rpx;
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid #b9bec7;
  border-radius: 50%;
  z-index: 1;
  pointer-events: none;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 4rpx;
  background-color: #b9bec7;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding: 0 28rpx 0 76rpx;
  background-color: #fff;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 41, 51, 0.05);
  font-size: 27rpx;
}

.search-placeholder {
  color: #b9bec7;
}

/* ================= 联想 ================= */
.sug-card {
  padding: 8rpx 28rpx;
}

.sug-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f4f5f8;
}

.sug-item:last-child {
  border-bottom: none;
}

.sug-hover {
  opacity: 0.7;
}

.sug-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-right: 18rpx;
  background: #eef7e4;
  border-radius: 12rpx;
  color: #4db900;
  font-size: 21rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.sug-body {
  flex: 1;
  min-width: 0;
}

.sug-name {
  font-size: 27rpx;
  font-weight: 500;
  color: #1f2933;
}

.sug-address {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #8a8f99;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ================= 场景 chips ================= */
.scene-bar {
  display: flex;
  margin: 20rpx 24rpx 0;
}

.scene-chip {
  padding: 12rpx 30rpx;
  margin-right: 14rpx;
  background: #fff;
  border: 2rpx solid #e8ebef;
  border-radius: 999rpx;
  color: #6b7280;
  font-size: 24rpx;
  transition: all 0.15s ease;
}

.scene-chip:last-child {
  margin-right: 0;
}

.scene-active {
  background: linear-gradient(135deg, #4db900, #6fce1e);
  border-color: transparent;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(77, 185, 0, 0.3);
}

/* ================= POI 横滑卡 ================= */
.poi-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
  box-sizing: border-box;
  padding: 0 24rpx;
}

.poi-card {
  display: inline-flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 320rpx;
  padding: 24rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 41, 51, 0.05);
  vertical-align: top;
}

.poi-hover {
  background: #fafbfc;
}

.poi-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2933;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poi-addr {
  margin-top: 8rpx;
  min-height: 56rpx;
  font-size: 22rpx;
  color: #8a8f99;
  line-height: 28rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  white-space: normal;
}

.poi-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.poi-dist {
  font-size: 20rpx;
  color: #4db900;
  font-weight: 600;
}

.poi-go {
  font-size: 21rpx;
  color: #b9bec7;
}

/* ================= 详情弹层 ================= */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.45);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  padding: 16rpx 32rpx 48rpx;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(31, 41, 51, 0.15);
  animation: sheet-up 0.22s ease;
}

@keyframes sheet-up {
  from { transform: translateY(40%); opacity: 0.4; }
  to { transform: translateY(0); opacity: 1; }
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 8rpx auto 24rpx;
  background: #e4e7ec;
  border-radius: 4rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2933;
  margin-bottom: 20rpx;
}

.sheet-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 25rpx;
}

.sheet-label {
  width: 100rpx;
  flex-shrink: 0;
  color: #8a8f99;
}

.sheet-value {
  flex: 1;
  color: #1f2933;
  line-height: 36rpx;
}

.sheet-phone {
  color: #3a7bd5;
}

.sheet-actions {
  display: flex;
  margin-top: 28rpx;
}

.sheet-actions .btn {
  flex: 1;
}

.sheet-actions .btn:first-child {
  margin-right: 20rpx;
}

.sheet-poster {
  width: 100%;
  margin-top: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 41, 51, 0.08);
}

/* ================= 路线面板 ================= */
.route-panel {
  margin: 20rpx 24rpx 40rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 41, 51, 0.05);
}

.segment {
  display: flex;
  padding: 6rpx;
  margin-bottom: 20rpx;
  background: #eef0f4;
  border-radius: 20rpx;
}

.segment-item {
  flex: 1;
  padding: 14rpx 0;
  text-align: center;
  border-radius: 14rpx;
  color: #6b7280;
  font-size: 26rpx;
  transition: all 0.2s ease;
}

.segment-item-active {
  background: #fff;
  color: #4db900;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 41, 51, 0.1);
}

.route-row {
  display: flex;
  margin-bottom: 8rpx;
}

.route-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0 10rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.route-hint .spinner {
  margin-right: 14rpx;
}

.route-item {
  flex: 1;
  padding: 10rpx 0;
  text-align: center;
}

.route-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2933;
}

.route-label {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8a8f99;
}